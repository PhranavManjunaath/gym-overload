# Copy this file to .env and fill in real values. Never commit .env.
GROQ_API_KEY=your-groq-api-key-here
# Optional - any Groq model that supports tool calling
GROQ_MODEL=openai/gpt-oss-120b
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# Supabase: Connect -> Connection string -> Session pooler -> URI (paste as-is, real password in place of [YOUR-PASSWORD])
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres
# Local alternative (no account needed):
# DATABASE_URL=sqlite:///data/gym.db

# App + website (optional): if set, both ask for this password (single user, not real accounts)
WEB_PASSWORD=
# Website: browser origins allowed to call the API (api.py)
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Reminders (optional - these are the defaults). Times are 24h HH:MM.
REMINDER_TIMEZONE=Asia/Kolkata
WORKOUT_DAYS=mon,wed,fri
WORKOUT_REMINDER_TIME=07:00
MISSED_WORKOUT_CHECK_TIME=21:00
MEAL_REMINDER_TIMES=08:00,13:00,20:00
