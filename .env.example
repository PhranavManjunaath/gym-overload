# Copy this file to .env and fill in real values. Never commit .env.
GROQ_API_KEY=your-groq-api-key-here
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# Supabase: Connect -> Connection string -> Session pooler -> URI (paste as-is, real password in place of [YOUR-PASSWORD])
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres
# Local alternative (no account needed):
# DATABASE_URL=sqlite:///data/gym.db
